# Copy this file to .env.local and fill it in. .env.local is git-ignored — never commit real keys.
# Used by `npm start` (scripts/dev-api.mjs) so the subscribe form works locally.
# On Vercel, set the same variables under Project → Settings → Environment Variables.

# MailerLite → Integrations → API → Generate new token
MAILERLITE_API_KEY=

# Optional: the subscriber group (defaults to "Blog subscribers"), or its id
# MAILERLITE_GROUP_NAME=Blog subscribers
# MAILERLITE_GROUP_ID=
